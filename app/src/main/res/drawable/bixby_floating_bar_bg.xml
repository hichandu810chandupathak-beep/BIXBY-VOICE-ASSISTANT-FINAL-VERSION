<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E61B2028" />
            <corners android:radius="32dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#20101820" />
            <corners android:radius="31dp" />
            <stroke android:width="1dp" android:color="#2638BDF8" />
        </shape>
    </item>
</layer-list>
