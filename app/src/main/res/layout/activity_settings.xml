<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/one_ui_black">
    
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Bixby settings" android:textColor="@color/white" android:textSize="34sp"
        android:textStyle="bold" android:padding="24dp" android:layout_marginTop="40dp" />
        
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/rounded_pill"
        android:backgroundTint="@color/one_ui_dark_gray" android:layout_margin="16dp" android:padding="24dp">
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gemini API Key" android:textColor="@color/white" android:textStyle="bold" android:textSize="16sp"/>
            
        <EditText android:id="@+id/etApiKey" android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Paste AIzaSy..." android:textColorHint="#888888" android:textColor="@color/white"
            android:backgroundTint="@color/bixby_blue" android:inputType="textPassword" android:layout_marginTop="8dp"/>
            
        <Button android:id="@+id/btnSaveSettings" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="SAVE &amp; FINISH" android:backgroundTint="@color/bixby_blue" android:textColor="@color/white"
            android:layout_marginTop="24dp" android:textStyle="bold" android:background="@drawable/rounded_pill"/>
    </LinearLayout>
</LinearLayout>