<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#070914">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BIXBY"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="How can I help?"
        android:textSize="18sp"
        android:textColor="#B9BDD4" />

    <TextView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="42dp"
        android:gravity="center"
        android:text="◉"
        android:textSize="110sp"
        android:textColor="#8B7CFF"
        android:background="#171A35" />

    <ImageButton
        android:id="@+id/micButton"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="30dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:contentDescription="Microphone"
        android:background="@android:color/transparent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Tap to talk"
        android:textSize="15sp"
        android:textColor="#8F93AA" />

</LinearLayout>