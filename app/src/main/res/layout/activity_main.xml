<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <!-- Lower Third Floating Bixby Sheet -->
    <LinearLayout
        android:id="@+id/bixbyBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bixby_card_bg"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Top Drag / Capsule Indicator -->
        <View
            android:id="@+id/topBarIndicator"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="#CBD5E1" />

        <!-- Assistant Response / Query Text -->
        <TextView
            android:id="@+id/tvAssistantStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Hello to you too! \uD83D\uDE0A"
            android:textColor="#0F172A"
            android:textSize="20sp" />

        <!-- Subtitle / Recognized Speech text -->
        <TextView
            android:id="@+id/tvUserQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="Listening for command..."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Suggestion Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:id="@+id/horizontalChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bixby_pill_bg"
                    android:fontFamily="sans-serif"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="What's the weather?"
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipAlarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bixby_pill_bg"
                    android:fontFamily="sans-serif"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="Set alarm at 7 AM"
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipJoke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bixby_pill_bg"
                    android:fontFamily="sans-serif"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="Tell me a joke"
                    android:textColor="#334155"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bottom Action Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnKeyboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="⌨"
                android:textColor="#475569"
                android:textSize="20sp" />

            <View
                android:id="@+id/bixbyListeningBar"
                android:layout_width="90dp"
                android:layout_height="6dp"
                android:layout_centerInParent="true"
                android:background="#0284C7" />

            <TextView
                android:id="@+id/btnMicTrigger"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="\uD83C\uDF99"
                android:textColor="#0284C7"
                android:textSize="20sp" />
        </RelativeLayout>

    </LinearLayout>
</FrameLayout>
