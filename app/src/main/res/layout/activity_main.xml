<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_main" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="54dp">
            <TextView android:id="@+id/menuButton" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="start|center_vertical" android:gravity="center" android:text="☰" android:textColor="@color/bixby_primary_text" android:textSize="21sp" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Menu" />
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@drawable/ic_bixby_mark" android:contentDescription="Bixby" />
            <TextView android:id="@+id/settingsButton" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="⚙" android:textColor="@color/bixby_primary_text" android:textSize="20sp" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Settings" />
        </FrameLayout>
        <FrameLayout android:id="@+id/contentArea" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/homeContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:text="How can I help you?" android:textColor="@color/bixby_secondary_text" android:textSize="14sp" />
                <TextView android:id="@+id/greetingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="-26dp" android:gravity="center" android:text="Hi, Chandan" android:textColor="@color/bixby_primary_text" android:textSize="23sp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <FrameLayout android:id="@+id/orbContainer" android:layout_width="250dp" android:layout_height="250dp" android:layout_gravity="center">
                        <View android:id="@+id/orb_outer" android:layout_width="250dp" android:layout_height="250dp" android:layout_gravity="center" android:background="@drawable/orb_outer" />
                        <View android:id="@+id/orb_middle" android:layout_width="218dp" android:layout_height="218dp" android:layout_gravity="center" android:background="@drawable/orb_middle" />
                        <View android:id="@+id/orb_glow" android:layout_width="194dp" android:layout_height="194dp" android:layout_gravity="center" android:background="@drawable/orb_glow" />
                        <TextView android:id="@+id/voiceOrb" android:layout_width="162dp" android:layout_height="162dp" android:layout_gravity="center" android:background="@drawable/orb_inner" android:textColor="@android:color/transparent" />
                        <ImageView android:id="@+id/bixbyOrbMark" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center" android:src="@drawable/ic_bixby_mark" android:contentDescription="Bixby" />
                    </FrameLayout>
                </FrameLayout>
                <LinearLayout android:id="@+id/quickActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/actionYoutube" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:paddingStart="16dp" android:text="▶   Open YouTube" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/actionMusic" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="5dp" android:gravity="center_vertical" android:paddingStart="16dp" android:text="♫   Play music" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/actionWeather" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="5dp" android:gravity="center_vertical" android:paddingStart="16dp" android:text="☁   What's the weather today?" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/actionAlarm" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="5dp" android:gravity="center_vertical" android:paddingStart="16dp" android:text="◷   Set an alarm for 7 AM" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/listeningContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
                <TextView android:id="@+id/listeningTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="38dp" android:gravity="center" android:text="Listening..." android:textColor="@color/bixby_blue" android:textSize="17sp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <FrameLayout android:layout_width="250dp" android:layout_height="250dp" android:layout_gravity="center">
                        <View android:id="@+id/listenOuter" android:layout_width="250dp" android:layout_height="250dp" android:layout_gravity="center" android:background="@drawable/orb_outer" />
                        <View android:id="@+id/listenMiddle" android:layout_width="205dp" android:layout_height="205dp" android:layout_gravity="center" android:background="@drawable/orb_middle" />
                        <View android:id="@+id/listenGlow" android:layout_width="174dp" android:layout_height="174dp" android:layout_gravity="center" android:background="@drawable/orb_glow" />
                        <ImageView android:layout_width="78dp" android:layout_height="78dp" android:layout_gravity="center" android:src="@drawable/ic_bixby_mark" />
                    </FrameLayout>
                    <ImageView android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="bottom" android:layout_marginBottom="24dp" android:src="@drawable/voice_wave" />
                </FrameLayout>
                <TextView android:id="@+id/cancelButton" android:layout_width="88dp" android:layout_height="40dp" android:layout_marginBottom="24dp" android:gravity="center" android:text="Cancel" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/status_pill" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <ScrollView android:id="@+id/conversationContent" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="24dp" android:paddingBottom="8dp">
                    <TextView android:id="@+id/userBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:maxWidth="280dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/user_bubble" />
                    <TextView android:id="@+id/assistantBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginStart="34dp" android:maxWidth="285dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/assistant_bubble" />
                    <LinearLayout android:id="@+id/weatherCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/weather_card" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Delhi, India" android:textColor="@color/bixby_secondary_text" android:textSize="12sp" />
                        <TextView android:id="@+id/weatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="32°" android:textColor="@color/bixby_primary_text" android:textSize="42sp" />
                        <TextView android:id="@+id/weatherSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partly Cloudy" android:textColor="@color/bixby_primary_text" android:textSize="13sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Feels like 35°     H: 33°     L: 24°\nHumidity 60%    Wind 12 km/h" android:textColor="@color/bixby_secondary_text" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
        <LinearLayout android:id="@+id/actionPanel" android:layout_width="match_parent" android:layout_height="68dp" android:background="@drawable/action_panel" android:elevation="4dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/actionHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ask Bixby anything" android:textColor="@color/bixby_primary_text" android:textSize="15sp" />
            <ImageButton android:id="@+id/micButton" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/mic_background" android:contentDescription="Microphone" android:padding="12dp" android:src="@drawable/ic_mic" android:tint="@color/bixby_mic_icon" android:scaleType="centerInside" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="28dp" android:layout_gravity="center_horizontal" android:gravity="center" android:text="Say Hey Bixby" android:textColor="@color/bixby_secondary_text" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
