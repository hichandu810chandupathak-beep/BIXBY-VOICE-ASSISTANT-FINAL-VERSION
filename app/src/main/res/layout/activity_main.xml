<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Bixby"
                android:src="@drawable/ic_bixby_mark"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="BIXBY"
                android:textColor="@color/bixby_primary_text"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/status_pill"
            android:gravity="center"
            android:minWidth="154dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="How can I help?"
            android:textColor="@color/bixby_secondary_text"
            android:textSize="14sp"
            android:alpha="0.96" />

        <FrameLayout
            android:id="@+id/orbContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <View
                android:id="@+id/orb_outer"
                android:layout_width="318dp"
                android:layout_height="318dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_outer"
                android:elevation="2dp" />

            <View
                android:id="@+id/orb_middle"
                android:layout_width="276dp"
                android:layout_height="276dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_middle"
                android:elevation="3dp" />

            <View
                android:id="@+id/orb_glow"
                android:layout_width="244dp"
                android:layout_height="244dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_glow"
                android:elevation="4dp"
                android:alpha="0.94" />

            <TextView
                android:id="@+id/voiceOrb"
                android:layout_width="204dp"
                android:layout_height="204dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_inner"
                android:elevation="5dp"
                android:gravity="center"
                android:text=""
                android:textColor="@android:color/transparent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="18dp"
                android:text="VOICE"
                android:textColor="@color/bixby_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.20"
                android:alpha="0.9" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/action_panel"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ask Bixby anything"
                android:textColor="@color/bixby_primary_text"
                android:textSize="15sp"
                android:alpha="0.96" />

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/mic_background"
                android:elevation="5dp"
                android:contentDescription="Microphone"
                android:padding="12dp"
                android:src="@drawable/ic_mic"
                android:scaleType="centerInside" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Say Hey Bixby"
            android:textColor="@color/bixby_secondary_text"
            android:textSize="11sp"
            android:alpha="0.82" />
    </LinearLayout>
</FrameLayout>
