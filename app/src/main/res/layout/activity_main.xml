<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070914">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="70dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIXBY"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.18" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="How can I help?"
            android:textSize="18sp"
            android:textColor="#B9BDD4" />

        <TextView
            android:id="@+id/voiceOrb"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="55dp"
            android:gravity="center"
            android:text="◉"
            android:textSize="120sp"
            android:textColor="#8B7CFF"
            android:background="#171A35" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="38dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Microphone"
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tap to talk"
            android:textSize="15sp"
            android:textColor="#8F93AA" />

    </LinearLayout>

</FrameLayout>