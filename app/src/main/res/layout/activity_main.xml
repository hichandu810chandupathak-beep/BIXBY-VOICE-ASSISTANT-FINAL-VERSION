<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <TextView
                android:id="@+id/menuButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="start|center_vertical"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/bixby_primary_text"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu" />
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bixby_mark"
                android:contentDescription="Bixby" />
            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/bixby_primary_text"
                android:textSize="21sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Hi, Chandan"
                    android:textColor="@color/bixby_primary_text"
                    android:textSize="23sp"
                    android:fontFamily="sans" />
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="How can I help you?"
                    android:textColor="@color/bixby_secondary_text"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:id="@+id/orbContainer"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:layout_gravity="center">
                        <View android:id="@+id/orb_outer" android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center" android:background="@drawable/orb_outer" />
                        <View android:id="@+id/orb_middle" android:layout_width="226dp" android:layout_height="226dp" android:layout_gravity="center" android:background="@drawable/orb_middle" />
                        <View android:id="@+id/orb_glow" android:layout_width="202dp" android:layout_height="202dp" android:layout_gravity="center" android:background="@drawable/orb_glow" />
                        <TextView android:id="@+id/voiceOrb" android:layout_width="166dp" android:layout_height="166dp" android:layout_gravity="center" android:background="@drawable/orb_inner" android:textColor="@android:color/transparent" />
                        <ImageView android:id="@+id/bixbyOrbMark" android:layout_width="78dp" android:layout_height="78dp" android:layout_gravity="center" android:src="@drawable/ic_bixby_mark" android:contentDescription="Bixby voice" />
                    </FrameLayout>
                </FrameLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:id="@+id/quickActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/actionYoutube" android:layout_width="wrap_content" android:layout_height="42dp" android:minWidth="128dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Open YouTube" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/actionMusic" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:minWidth="120dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Play music" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/actionWeather" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:minWidth="150dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Today's weather" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/actionAlarm" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:minWidth="142dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Set an alarm" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/action_panel" android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listeningContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">
                <TextView android:id="@+id/listeningTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:gravity="center" android:text="Listening..." android:textColor="@color/bixby_blue" android:textSize="17sp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <FrameLayout android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center">
                        <View android:id="@+id/listenOuter" android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center" android:background="@drawable/orb_outer" />
                        <View android:id="@+id/listenMiddle" android:layout_width="214dp" android:layout_height="214dp" android:layout_gravity="center" android:background="@drawable/orb_middle" />
                        <View android:id="@+id/listenGlow" android:layout_width="182dp" android:layout_height="182dp" android:layout_gravity="center" android:background="@drawable/orb_glow" />
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:src="@drawable/ic_bixby_mark" />
                    </FrameLayout>
                    <ImageView android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="bottom" android:layout_marginBottom="28dp" android:src="@drawable/voice_wave" />
                </FrameLayout>
                <TextView android:id="@+id/cancelButton" android:layout_width="96dp" android:layout_height="42dp" android:layout_marginBottom="24dp" android:gravity="center" android:text="Cancel" android:textColor="@color/bixby_primary_text" android:textSize="13sp" android:background="@drawable/status_pill" android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/conversationContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/conversationColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">
                    <TextView android:id="@+id/userBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:maxWidth="300dp" android:paddingStart="17dp" android:paddingEnd="17dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:textColor="@color/bixby_primary_text" android:textSize="14sp" android:lineSpacingExtra="2dp" android:background="@drawable/user_bubble" />
                    <TextView android:id="@+id/assistantBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginStart="12dp" android:maxWidth="310dp" android:paddingStart="17dp" android:paddingEnd="17dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:textColor="@color/bixby_primary_text" android:textSize="14sp" android:lineSpacingExtra="2dp" android:background="@drawable/assistant_bubble" />
                    <LinearLayout android:id="@+id/weatherCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/weather_card" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Delhi, India" android:textColor="@color/bixby_secondary_text" android:textSize="12sp" />
                        <TextView android:id="@+id/weatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="32°" android:textColor="@color/bixby_primary_text" android:textSize="42sp" />
                        <TextView android:id="@+id/weatherSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partly Cloudy" android:textColor="@color/bixby_primary_text" android:textSize="13sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Feels like 35°     H: 33°     L: 24°\nHumidity 60%    Wind 12 km/h" android:textColor="@color/bixby_secondary_text" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/action_panel"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="8dp">
            <TextView android:id="@+id/actionHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ask Bixby anything" android:textColor="@color/bixby_primary_text" android:textSize="15sp" />
            <ImageButton android:id="@+id/keyboardButton" android:layout_width="48dp" android:layout_height="54dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Type to Bixby" android:padding="12dp" android:src="@drawable/ic_keyboard" android:tint="@color/bixby_secondary_text" android:scaleType="centerInside" />
            <ImageButton android:id="@+id/micButton" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/mic_background" android:contentDescription="Microphone" android:padding="12dp" android:src="@drawable/ic_mic" android:tint="@color/bixby_mic_icon" android:scaleType="centerInside" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="26dp" android:layout_gravity="center_horizontal" android:gravity="center" android:text="Say “Hey Bixby”" android:textColor="@color/bixby_secondary_text" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/textInputPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/action_panel"
        android:elevation="8dp"
        android:visibility="gone">
        <EditText android:id="@+id/textInput" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:hint="Ask Bixby..." android:singleLine="true" android:imeOptions="actionSend" android:inputType="textCapSentences|textAutoCorrect" android:textColor="@color/bixby_primary_text" android:textColorHint="@color/bixby_secondary_text" android:background="@android:color/transparent" android:paddingStart="12dp" android:paddingEnd="8dp" />
        <ImageButton android:id="@+id/sendButton" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/mic_background" android:contentDescription="Send" android:src="@drawable/ic_send" android:tint="@color/bixby_mic_icon" />
    </LinearLayout>
</FrameLayout>
