<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="44dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIXBY"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.22" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="How can I help?"
            android:textColor="#C9CBE0"
            android:textSize="17sp" />

        <FrameLayout
            android:layout_width="330dp"
            android:layout_height="330dp"
            android:layout_marginTop="28dp"
            android:gravity="center">

            <View
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_outer" />

            <View
                android:layout_width="285dp"
                android:layout_height="285dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_middle" />

            <View
                android:layout_width="245dp"
                android:layout_height="245dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_glow" />

            <TextView
                android:id="@+id/voiceOrb"
                android:layout_width="175dp"
                android:layout_height="175dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="◉"
                android:textColor="#FFFFFF"
                android:textSize="70sp"
                android:background="@drawable/orb_inner"
                android:elevation="12dp" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOICE"
            android:textColor="#777B94"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.30" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/mic_background"
            android:contentDescription="Microphone"
            android:padding="18dp"
            android:src="@android:drawable/ic_btn_speak_now" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="Tap to talk"
            android:textColor="#969AAF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Say Hey Bixby"
            android:textColor="#5F647B"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>